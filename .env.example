# Copy to .env on the VM and fill in. .env is git-ignored.
DB_USER=vmgmt
DB_PASSWORD=TVgvQT1KFXdebbxc3mGpG8jlkzRbP8e
DB_NAME=vehicle_management
DB_PORT=5432

# Must match how the Java API is configured: local | gcs
# Copy this file to .env and fill it in.  `cp .env.example .env`
#
# .env is gitignored; this file is committed, so nothing in it may be a real secret.
# A real environment variable always beats a line here, so a container or a systemd unit can
# set the production values and this file stays a developer convenience.
#
# Every setting below is declared in ocr/config.py with its default and the reason for it.
# `python worker.py --check` prints what the worker actually resolved to, and stops.


# ── the database ────────────────────────────────────────────────────────────
# This worker reads and writes vehicle_intake directly, in the SAME database the
# vehicleManagement API migrates. There is no default password: a worker that guessed would
# happily find a table of the right shape in a stale copy and claim rows out of it.

VM_DATABASE_HOST=127.0.0.1
VM_DATABASE_PORT=5432
VM_DATABASE_NAME=vehicle_management
VM_DATABASE_USER=postgres
VM_DATABASE_PASSWORD=

# Alternative to the five lines above: one libpq connection string, which wins when set.
# Mind the encoding -- a password of faber@123 must be written faber%40123 here, or libpq
# reads the @ as the start of the hostname. The split form above has no such trap, because
# psycopg quotes each value itself. Prefer the split form.
#
# VM_DB_URL=postgresql://postgres:faber%40123@127.0.0.1:5432/vehicle_management

# The scratch database for `pytest`. Separate from the above on purpose: the suite truncates
# vehicle_intake, and one variable for both would eventually do that to a real database.
# VM_TEST_DATABASE_URL=postgresql://postgres:pw@127.0.0.1:5432/vm_ocr_test


# ── the photos ──────────────────────────────────────────────────────────────
# MUST match vehicle-management.intake.storage-backend on the API side. The API writes the
# keys and this worker reads them, so two different backends means a worker that fails every
# job for "photos no longer available" while the photos sit safely in the other store.

VM_IMAGE_BACKEND=local
# local: host folder the API saves photos into (mounted read-only)
IMAGE_HOST_DIR=/path/to/api/uploads
# gcs:

# Where the local backend reads. Only correct when this process shares a filesystem with the
# API -- on one machine that is the API's own uploads directory.
VM_IMAGE_DIR=C:/repos/vehicleManagement/uploads

# Required when VM_IMAGE_BACKEND=gcs. Credentials come from GOOGLE_APPLICATION_CREDENTIALS
# or the ambient service account, exactly as on the Java side.
# VM_GCS_BUCKET=
# VM_GCS_PREFIX=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs.json

VM_POLL_SECONDS=5
VM_BATCH=1
VM_STALE_MINUTES=15

# ── the loop ────────────────────────────────────────────────────────────────
# Defaults are fine for a single worker; all three are in ocr/config.py.
# There is no retry setting, deliberately -- see ocr/db.py:record_failure.

# VM_POLL_SECONDS=5
# VM_BATCH=1
# VM_STALE_MINUTES=15
